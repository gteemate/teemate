# .env: the LIVE database (and what the published app uses via .env.production).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_ACCESS_TOKEN=sbp_...
OWNER_EMAIL=you@example.com

# .env.test (a separate file, git-ignored): the TEST database, a second Supabase project.
#   VITE_SUPABASE_URL=https://test-project-ref.supabase.co
#   VITE_SUPABASE_ANON_KEY=sb_publishable_...
#   SUPABASE_ACCESS_TOKEN=sbp_...   (a token for the test project only)
# npm run dev, db:migrate, db:test, db:seed and db:scenarios use the test database; add :live / --live for live.
